<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jinjin.mapper.SetmealDishMapper">


    <select id="countByDishId" resultType="java.lang.Integer">
        select count(*) from setmeal_dish where dish_id in
        <foreach collection="dishIds" item="dishId" open="(" close=")">
            #{dishId}
        </foreach>
    </select>
</mapper>